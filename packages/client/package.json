{
  "name": "@forges-proxy/client",
  "version": "0.1.0-alpha.0",
  "description": "Drop-in forges providers backed by a forges-proxy server",
  "keywords": [
    "azure-devops",
    "bitbucket",
    "client",
    "cloudflare-artifacts",
    "credential-broker",
    "cursor-origin",
    "entire",
    "forgejo",
    "forges",
    "git",
    "gitbucket",
    "gitcafe",
    "gitea",
    "gitee",
    "github",
    "gitlab",
    "proxy",
    "pushin",
    "sourcehut",
    "tangled",
    "upstream"
  ],
  "homepage": "https://github.com/serhalp/forges-proxy/tree/main/packages/client#readme",
  "bugs": "https://github.com/serhalp/forges-proxy/issues",
  "license": "MIT",
  "author": "Philippe Serhal <philippe.serhal@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serhalp/forges-proxy.git",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@forges-proxy/source": "./src/remote.ts",
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    },
    "./all": {
      "@forges-proxy/source": "./src/all.ts",
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --conditions=@forges-proxy/source --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "eventsource-parser": "^4.1.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "forges": "0.4.1",
    "tsdown": "0.23.7"
  },
  "peerDependencies": {
    "forges": "~0.4.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
