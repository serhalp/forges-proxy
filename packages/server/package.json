{
  "name": "@forges-proxy/server",
  "version": "0.0.0",
  "description": "A self-hostable credential broker and cache for forges, over HTTP",
  "keywords": [
    "api-gateway",
    "azure-devops",
    "bitbucket",
    "cloudflare-artifacts",
    "credential-broker",
    "cursor-origin",
    "entire",
    "forgejo",
    "forges",
    "git",
    "gitbucket",
    "gitea",
    "gitee",
    "github",
    "gitlab",
    "proxy",
    "pushin",
    "sourcehut",
    "tangled"
  ],
  "homepage": "https://github.com/serhalp/forges-proxy/tree/main/packages/server#readme",
  "bugs": "https://github.com/serhalp/forges-proxy/issues",
  "license": "MIT",
  "author": "Philippe Serhal <philippe.serhal@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serhalp/forges-proxy.git",
    "directory": "packages/server"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@forges-proxy/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "srvx --watch --prod=false ./dev.ts",
    "test": "node --conditions=@forges-proxy/source --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:coverage": "node --conditions=@forges-proxy/source --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"src/**/*.test.ts\" --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "forges": "^0.3.2",
    "h3": "^2.0.8",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "srvx": "1.0.8",
    "tsdown": "0.23.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
