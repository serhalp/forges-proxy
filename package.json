{
  "name": "forges-proxy-monorepo",
  "private": true,
  "description": "Self-hosted HTTP proxy and credential broker for forges, with a typed client and deployment demos",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/*' build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint",
    "smoke": "node --conditions=@forges-proxy/source scripts/smoke.ts",
    "test": "pnpm -r test",
    "typecheck": "pnpm typecheck:src && pnpm typecheck:demos",
    "typecheck:demos": "pnpm build && pnpm --filter './demos/*' typecheck",
    "typecheck:src": "tsc --noEmit && pnpm --filter './packages/*' typecheck",
    "zizmor": "zizmor --pedantic .",
    "zizmor:fix": "zizmor --pedantic --fix ."
  },
  "devDependencies": {
    "@forges-proxy/client": "workspace:*",
    "@forges-proxy/server": "workspace:*",
    "@types/node": "26.6.6",
    "evlog": "2.35.1",
    "forges": "0.4.1",
    "knip": "6.45.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "valibot": "1.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  }
}
