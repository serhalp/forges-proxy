{
  "name": "forges-proxy-monorepo",
  "private": true,
  "description": "Monorepo for forges-proxy: a self-hostable credential broker for forges, its client and deployment demos",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/*' build",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "oxlint",
    "knip": "knip",
    "test": "pnpm -r test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "smoke": "node --conditions=@forges-proxy/source scripts/smoke.ts",
    "zizmor": "zizmor --pedantic .",
    "zizmor:fix": "zizmor --pedantic --fix ."
  },
  "devDependencies": {
    "@forges-proxy/client": "workspace:*",
    "@forges-proxy/server": "workspace:*",
    "@types/node": "26.6.6",
    "forges": "0.3.2",
    "knip": "6.44.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "valibot": "1.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  }
}
