{
  "name": "forges-proxy",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "build": "nitro build",
    "dev": "nitro dev",
    "preview": "nitro preview",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --experimental-test-module-mocks --test \"test/**/*.test.ts\"",
    "test:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"../forges/**\" --test \"test/**/*.test.ts\"",
    "manifest": "node scripts/generate-manifest.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@netlify/functions": "6.0.1",
    "forges": "link:../forges"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.73.0",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "7.0.2",
    "typescript-6": "npm:typescript@6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
